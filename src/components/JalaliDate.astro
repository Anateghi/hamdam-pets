---
// Jalali date input: day / month / year. Wire up with jalaliPicker() from src/scripts/jalali.js
const { id, label } = Astro.props;
---
<fieldset class="jfield" id={id} style="border:0;padding:0;margin:0">
  <legend style="font-weight:700;margin:12px 0 4px;padding:0">{label}</legend>
  <div class="jdate">
    <select data-jd aria-label="روز"></select>
    <select data-jm aria-label="ماه"></select>
    <input data-jy type="number" min="1380" max="1450" inputmode="numeric" aria-label="سال (شمسی)" />
  </div>
</fieldset>
