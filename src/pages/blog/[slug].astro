---
import Base from '../../layouts/Base.astro';
import Illo from '../../components/Illo.astro';
import Faq from '../../components/Faq.astro';
import VetNote from '../../components/VetNote.astro';
import Reactions from '../../components/Reactions.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, SITE, jalali, fa } from '../../lib/site';
import { TOOLS } from '../../lib/tools';
export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((a) => ({ params: { slug: a.id }, props: { a, all } }));
}
const { a, all } = Astro.props;
const { Content, headings } = await render(a);
const d = a.data; const cat = CATEGORIES[d.category];
const url = new URL(Astro.url.pathname, Astro.site).href;
const words = (a.body || '').split(/\s+/).length;
const related = [...d.related.map((s: string) => all.find((x: any) => x.id === s)).filter(Boolean),
  ...all.filter((x: any) => x.id !== a.id && x.data.category === d.category && !d.related.includes(x.id))].slice(0, 3);
const tools = TOOLS.filter((t) => d.tools.includes(t.slug));
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, inLanguage: 'fa-IR', datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(), mainEntityOfPage: url, wordCount: words, keywords: d.keyword, author: { '@type': 'Organization', name: `تحریریهٔ ${SITE.name}` }, publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/logo.svg', Astro.site).href } }, image: new URL('/og.png', Astro.site).href },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'خانه', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: cat.title, item: new URL(`/${d.category}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url }] },
];
if (d.faq.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.title} description={d.description} type="article" schema={schema}>
  <div class="wrap">
    <nav class="crumbs"><a href="/">خانه</a> › <a href={`/${d.category}/`}>{cat.title}</a> › {d.title}</nav>
    <div class="article">
      <article class="prose">
        <h1>{d.title}</h1>
        <p class="meta">تحریریهٔ همدم · انتشار: <time datetime={d.date.toISOString()}>{jalali(d.date)}</time> · زمان مطالعه: حدود {fa(Math.ceil(words / 200))} دقیقه</p>
        <Illo name={d.illustration} class="cover" />
        {d.health && <VetNote />}
        <Content />
        <Faq items={d.faq} />
        <VetNote />
        <Reactions title="این مطلب" />
      </article>
      <aside class="side">
        {tools.map((t) => <div class="toolbox"><h3>ابزار رایگان</h3><p>{t.blurb}</p><a class="btn" href={`/tools/${t.slug}/`}>{t.title}</a></div>)}
        {headings.filter((h) => h.depth === 2).length > 2 && <div class="card"><b>در این مقاله</b>{headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</div>}
        <div class="card"><b>مطالب مرتبط</b>{related.map((r: any) => <a href={`/blog/${r.id}/`}>{r.data.title}</a>)}</div>
      </aside>
    </div>
  </div>
</Base>
<style>.cover{width:100%;max-height:300px;background:var(--sand);border-radius:18px}</style>
