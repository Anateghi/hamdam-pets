---
import Tool from '../../layouts/Tool.astro';
import { QUESTIONS } from '../../scripts/quiz.js';
const faq = [
  { q: 'برای آپارتمان چه حیوانی بهتر است؟', a: 'گربه‌ها، سگ‌های کوچک کم‌انرژی، پرندگانی مثل مرغ عشق و عروس هلندی، ماهی آکواریومی و جوندگانی مثل همستر برای آپارتمان مناسب‌ترند. مهم‌تر از متراژ، وقتی است که هر روز برای حیوان می‌گذارید و اینکه چند ساعت تنها می‌ماند.' },
  { q: 'برای کسی که آلرژی دارد چه حیوانی مناسب است؟', a: 'ماهی آکواریومی کمترین خطر را دارد. هیچ نژاد سگ یا گربه‌ای واقعاً «ضدحساسیت» نیست، چون آلرژن‌ها در بزاق و پوست هم هستند، نه فقط در مو. نژادهای کم‌ریزش مثل پودل یا مالتیز برای برخی افراد قابل‌تحمل‌ترند. پیش از آوردن حیوان، چند ساعت با همان نژاد وقت بگذرانید و با پزشک آلرژی مشورت کنید.' },
  { q: 'بهترین حیوان خانگی برای بچه‌ها چیست؟', a: 'برای کودکان خردسال، حیوانی که بغل کردنش آسیب نزند و صبور باشد بهتر است: سگ‌های خانوادگی مثل گلدن رتریور، گربه‌های آرام یا ماهی آکواریومی. همستر شب‌فعال است و ممکن است گاز بگیرد. در هر حال، مسئولیت اصلی با بزرگسال است و بازی کودک با حیوان باید زیر نظر باشد.' },
  { q: 'این آزمون چقدر دقیق است؟', a: 'یک راهنمای اولیه است که بر اساس نیازهای شناخته‌شدهٔ هر حیوان (فضا، وقت، هزینه، تحمل تنهایی، سروصدا و...) امتیاز می‌دهد. شخصیت هر حیوان فرق دارد؛ پیش از تصمیم، مقالهٔ مربوطه را بخوانید و با دامپزشک یا پناهگاه حیوانات صحبت کنید.' },
  { q: 'خرید یا فرزندخواندگی؟', a: 'هزاران گربه و سگ در پناهگاه‌ها و خیابان‌ها منتظر خانه‌اند. فرزندخواندگی، به‌ویژه برای گربه‌ها و سگ‌های دورگه، معمولاً حیوانی سالم‌تر، کم‌هزینه‌تر و با شخصیت شناخته‌شده به شما می‌دهد. اگر نژاد خاصی می‌خواهید، فقط از پرورش‌دهندهٔ مسئولی بخرید که آزمایش‌های سلامت والدین را نشان دهد.' },
];
const links = [['/blog/small-dog-breeds/','نژاد سگ‌های کوچک آپارتمانی'],['/blog/british-shorthair-cat/','گربه بریتیش شورت‌هیر'],['/blog/budgie-lifespan/','مرغ عشق'],['/blog/freshwater-aquarium-fish/','ماهی‌های آکواریومی آب شیرین'],['/blog/hamster-care/','همستر خانگی'],['/tools/aquarium-calculator/','محاسبه حجم آکواریوم']];
const fa = (s: string | number) => String(s).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
---
<Tool title="کدام حیوان خانگی مناسب من است؟ (آزمون رایگان)" h1="آزمون: کدام حیوان خانگی یا نژاد مناسب من است؟" description="با ۱۰ سؤال ساده دربارهٔ خانه، وقت، بودجه، حساسیت، کودکان و سبک زندگی، ببینید گربه، کدام نژاد سگ، پرنده، ماهی یا همستر برای شما مناسب‌تر است؛ همراه دلیل و راهنمای مطالعه." slug="pet-quiz" illo="quiz" faq={faq} links={links}>
  <form slot="calc" class="calc qz" id="qform">
    {QUESTIONS.map(([k, q, opts], i) => (
      <fieldset><legend>{fa(i + 1)}. {q}</legend>{opts.map((o, j) => <label><input type="radio" name={k} value={j} required /> {o}</label>)}</fieldset>
    ))}
    <div class="actions"><button class="btn" type="submit">نتیجه را ببین</button><button class="btn sec" type="reset">از نو</button></div>
    <p class="meta" id="qerr" hidden style="color:var(--pom)">لطفاً به همهٔ سؤال‌ها پاسخ دهید.</p>
    <div class="result" id="qres" hidden aria-live="polite"><div>بیشترین تناسب با شما</div><div class="big" id="qtop"></div><div id="qpicks"></div></div>
  </form>
  <p>آوردن حیوان خانگی تصمیمی ده‌ پانزده ساله است. بسیاری از حیواناتی که رها می‌شوند، قربانی یک انتخاب عجولانه‌اند: سگ پرانرژی در آپارتمان کوچک خانواده‌ای پرمشغله، یا طوطی پرسروصدا برای کسی که آرامش می‌خواست. این آزمون با ۱۰ سؤال دربارهٔ شرایط واقعی زندگی‌تان، حیوان‌ها و گروه‌های نژادی مختلف را امتیازدهی می‌کند و سه گزینهٔ اول را همراه دلیل و نقاط احتیاط نشان می‌دهد.</p>
  <h2>پیش از انتخاب به این پنج سؤال فکر کنید</h2>
  <ol>
    <li><strong>وقت:</strong> سگ‌ها روزانه یک تا دو ساعت پیاده‌روی و بازی می‌خواهند؛ گربه‌ها و پرندگان هم بدون بازی روزانه دچار مشکل رفتاری می‌شوند.</li>
    <li><strong>تنهایی:</strong> سگ‌ها و طوطی‌سانان حیوانات اجتماعی‌اند و تنهایی طولانی هر روزه برایشان سخت است.</li>
    <li><strong>هزینه:</strong> غذای باکیفیت، واکسن، ضدانگل، عقیم‌سازی و هزینه‌های پیش‌بینی‌نشدهٔ درمان را حساب کنید. برای تخمین غذا از <a href="/tools/food-calculator/">ماشین‌حساب غذای سگ و گربه</a> استفاده کنید.</li>
    <li><strong>طول عمر:</strong> گربه ۱۲ تا ۱۸ سال، سگ ۱۰ تا ۱۵ سال، عروس هلندی ۱۵ تا ۲۰ سال و همستر فقط ۲ تا ۳ سال عمر می‌کند.</li>
    <li><strong>خانواده:</strong> همهٔ اعضای خانه موافق‌اند؟ کسی حساسیت دارد؟ صاحب‌خانه اجازه می‌دهد؟</li>
  </ol>
  <h2>خلاصهٔ نیازهای حیوانات رایج</h2>
  <table><thead><tr><th>حیوان</th><th>فضا</th><th>وقت روزانه</th><th>تحمل تنهایی</th><th>نکته</th></tr></thead><tbody>
    <tr><td>گربه</td><td>کم</td><td>متوسط</td><td>خوب</td><td>ظرف خاک تمیز و بازی روزانه</td></tr>
    <tr><td>سگ کوچک</td><td>کم</td><td>متوسط</td><td>متوسط</td><td>پیاده‌روی روزانه، اجتماعی‌سازی</td></tr>
    <tr><td>سگ بزرگ</td><td>زیاد</td><td>زیاد</td><td>کم</td><td>آموزش و ورزش جدی</td></tr>
    <tr><td>مرغ عشق / عروس هلندی</td><td>کم</td><td>متوسط</td><td>متوسط</td><td>قفس بزرگ و پرواز بیرون از قفس</td></tr>
    <tr><td>ماهی آکواریومی</td><td>کم</td><td>کم</td><td>خوب</td><td>چرخهٔ نیتروژن و تعویض آب</td></tr>
    <tr><td>همستر</td><td>کم</td><td>کم</td><td>خوب</td><td>شب‌فعال، تنها نگه داشته شود</td></tr>
  </tbody></table>
  <p>اگر گربه در صدر نتایج شما بود، <a href="/blog/british-shorthair-cat/">بریتیش شورت‌هیر</a> و گربه‌های دورگهٔ پناهگاه گزینه‌های آرامی‌اند. برای سگ در آپارتمان، <a href="/blog/small-dog-breeds/">نژادهای کوچک آپارتمانی</a> را ببینید. اگر پرنده می‌خواهید، از <a href="/blog/budgie-lifespan/">مرغ عشق</a> شروع کنید و برای آکواریوم، اول با <a href="/tools/aquarium-calculator/">ماشین‌حساب حجم آکواریوم</a> ببینید چند ماهی جا دارد. <a href="/blog/hamster-care/">همستر</a> هم برای کودکان بزرگ‌تر و افراد کم‌وقت انتخاب خوبی است.</p>
  <script>
    import { score } from '../../scripts/quiz.js';
    import { fa } from '../../scripts/jalali.js';
    const f = document.getElementById('qform');
    f.addEventListener('submit', (e) => {
      e.preventDefault(); const d = new FormData(f), keys = ['space', 'time', 'home', 'budget', 'allergy', 'exp', 'kids', 'act', 'noise', 'goal'];
      if (keys.some((k) => d.get(k) === null)) { document.getElementById('qerr').hidden = false; return; }
      document.getElementById('qerr').hidden = true;
      const ans = Object.fromEntries(keys.map((k) => [k, +d.get(k)])); const r = score(ans).slice(0, 3);
      document.getElementById('qtop').textContent = r[0].name; document.getElementById('qtop').dataset.id = r[0].id;
      const box = document.getElementById('qpicks'); box.innerHTML = '';
      r.forEach((p, i) => { const el = document.createElement('div'); el.className = 'pick'; el.innerHTML = `<b>${fa(i + 1)}. ${p.name}</b> · تناسب ${fa(p.score)}٪<br>${p.why}${p.cons.length ? '<br><small>احتیاط: ' + p.cons.join('، ') + '</small>' : ''}<br><a href="${p.href}">بیشتر بخوانید ←</a>`; box.appendChild(el); });
      const res = document.getElementById('qres'); res.hidden = false; res.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    f.addEventListener('reset', () => { document.getElementById('qres').hidden = true; });
  </script>
</Tool>
