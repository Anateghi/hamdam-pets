---
import Tool from '../../layouts/Tool.astro';
const faq = [
  { q: 'سگ یا گربه‌ام روزی چند گرم غذا باید بخورد؟', a: 'مقدار درست به وزن، سن، عقیم بودن، میزان فعالیت و کالری غذا بستگی دارد. ابتدا انرژی پایه (RER = ۷۰ × وزن به توان ۰٫۷۵) حساب می‌شود، سپس در ضریب مرحلهٔ زندگی ضرب می‌شود تا نیاز روزانه (MER) به کیلوکالری به دست آید. در پایان این عدد بر کالری هر گرم غذا تقسیم می‌شود. برای نمونه یک سگ ۱۰ کیلویی بالغ و عقیم‌شده حدود ۶۳۰ کیلوکالری در روز نیاز دارد که با غذای خشک ۳۵۰۰ کیلوکالری در کیلوگرم حدود ۱۸۰ گرم می‌شود.' },
  { q: 'کالری غذا را از کجا بفهمم؟', a: 'روی بیشتر بسته‌های غذای استاندارد عبارت «انرژی قابل متابولیسم» (ME) با واحد kcal/kg یا kcal/100g نوشته شده است. اگر عدد بر حسب ۱۰۰ گرم است آن را در ۱۰ ضرب کنید. اگر روی بسته کالری ذکر نشده باشد، عدد پیش‌فرض ماشین‌حساب (غذای خشک سگ حدود ۳۵۰۰، غذای خشک گربه حدود ۳۸۰۰ و غذای مرطوب حدود ۱۰۰۰ کیلوکالری در کیلوگرم) یک تخمین میانگین است.' },
  { q: 'چرا عدد ماشین‌حساب با جدول روی بستهٔ غذا فرق دارد؟', a: 'جدول روی بسته‌ها معمولاً برای سگ‌ها و گربه‌های فعال و عقیم‌نشده نوشته می‌شود و اغلب کمی بیشتر از نیاز حیوانات خانگی آپارتمانی و عقیم‌شده است. هر دو عدد نقطهٔ شروع‌اند. معیار نهایی وزن و وضعیت بدنی (BCS) حیوان است.' },
  { q: 'اگر هم غذای خشک بدهم هم مرطوب، چطور حساب کنم؟', a: 'کالری روزانه را تقسیم کنید. مثلاً اگر یک‌چهارم انرژی از غذای مرطوب می‌آید، یک‌چهارم MER را با کالری غذای مرطوب و سه‌چهارم را با کالری غذای خشک به گرم تبدیل کنید. تشویقی‌ها هم کالری دارند و بهتر است بیش از ۱۰ درصد انرژی روزانه نباشند.' },
  { q: 'برای کاهش وزن چقدر غذا بدهم؟', a: 'در برنامهٔ کاهش وزن، محاسبه بر اساس وزن ایده‌آل (نه وزن فعلی) انجام می‌شود و ضریب حدود ۱ برای سگ و ۰٫۸ برای گربه است. کاهش وزن باید آهسته باشد (حدود ۱ تا ۲ درصد وزن بدن در هفته). گربه‌ها به‌خصوص نباید ناگهان گرسنه بمانند، چون خطر بیماری کبد چرب دارند؛ پس رژیم را با نظارت دامپزشک شروع کنید.' },
  { q: 'این ماشین‌حساب برای حیوان باردار، شیرده یا بیمار مناسب است؟', a: 'خیر. نیاز انرژی در بارداری و شیردهی تا چند برابر افزایش می‌یابد و در بیماری‌هایی مثل بیماری کلیه، دیابت یا پرکاری تیروئید جیره باید توسط دامپزشک تنظیم شود. این ابزار برای حیوانات سالم طراحی شده است.' },
];
const links = [['/blog/cat-food-homemade/','غذای گربه خانگی'],['/blog/street-cat-food/','غذای گربه‌های خیابانی'],['/blog/small-dog-breeds/','نژاد سگ‌های کوچک آپارتمانی'],['/blog/persian-cat/','راهنمای گربه پرشین'],['/tools/cat-age/','محاسبه سن گربه به انسان'],['/tools/dog-age/','محاسبه سن سگ به انسان']];
---
<Tool title="محاسبه مقدار غذای سگ و گربه در روز (کالری و گرم)" h1="محاسبه مقدار غذای سگ و گربه" description="ماشین‌حساب رایگان مقدار غذای روزانهٔ سگ و گربه: بر اساس وزن، سن، عقیم بودن و فعالیت، کالری روزانه (RER و MER) و گرم غذای خشک یا مرطوب را حساب کنید." slug="food-calculator" illo="food" faq={faq} links={links}>
  <div slot="calc" class="calc" id="foodcalc">
    <div class="row">
      <div><label for="fsp">حیوان</label><select id="fsp"><option value="dog">سگ</option><option value="cat">گربه</option></select></div>
      <div><label for="fkg">وزن (کیلوگرم)</label><input id="fkg" type="number" min="0.3" max="100" step="0.1" value="10" inputmode="decimal" /></div>
    </div>
    <label for="fst">مرحلهٔ زندگی</label>
    <select id="fst"></select>
    <div class="row">
      <div><label for="fneu">عقیم‌سازی</label><select id="fneu"><option value="y">عقیم‌شده</option><option value="n">عقیم‌نشده</option></select></div>
      <div><label for="fact">میزان فعالیت</label><select id="fact"></select></div>
    </div>
    <div class="row">
      <div><label for="ftype">نوع غذا</label><select id="ftype"><option value="dry">خشک (دانه‌ای)</option><option value="wet">مرطوب (کنسرو/پوچ)</option></select></div>
      <div><label for="fkcal">کالری غذا (kcal/kg)</label><input id="fkcal" type="number" min="300" max="6000" step="10" value="3500" inputmode="numeric" /></div>
    </div>
    <label for="fmeals">تعداد وعده در روز</label>
    <select id="fmeals"><option>1</option><option selected>2</option><option>3</option><option>4</option></select>
    <p class="meta" id="fhint" style="margin:8px 0 0"></p>
    <div class="result" aria-live="polite">
      <div>مقدار غذای روزانه</div>
      <div class="big" id="fgram"></div>
      <div id="fmeal"></div>
      <div id="fkc" style="margin-top:6px"></div>
      <div id="fdet" style="opacity:.85;font-size:.9rem;margin-top:6px"></div>
    </div>
  </div>
  <p>«روزی چند گرم غذا به سگم بدهم؟» یا «گربه‌ام چقدر غذا لازم دارد؟» از پرتکرارترین سؤال‌های صاحبان حیوانات خانگی است. پاسخ دقیق با حجم پیمانه به دست نمی‌آید، بلکه با <strong>انرژی</strong>: هر حیوان روزانه تعداد مشخصی کیلوکالری لازم دارد و هر غذا در هر گرم مقدار مشخصی کالری دارد. ماشین‌حساب همدم از فرمول‌های استاندارد دامپزشکی (راهنمای تغذیهٔ WSAVA و AAHA) استفاده می‌کند تا این دو عدد را به گرم روزانه تبدیل کند.</p>
  <h2>فرمول محاسبه نیاز انرژی سگ و گربه</h2>
  <h3>۱. انرژی پایه در حال استراحت (RER)</h3>
  <p>RER انرژی لازم برای کارکرد بدن در حالت استراحت است: <strong>RER = ۷۰ × (وزن بدن به کیلوگرم)<sup>۰٫۷۵</sup></strong>. برای نمونه، ۱۰ به توان ۰٫۷۵ تقریباً ۵٫۶۲ است؛ پس RER یک سگ ۱۰ کیلویی حدود ۳۹۴ کیلوکالری است.</p>
  <h3>۲. نیاز انرژی روزانه (MER)</h3>
  <p>MER همان RER ضرب در یک ضریب است که به گونه، سن، عقیم بودن و فعالیت بستگی دارد. همان سگ ۱۰ کیلویی اگر بالغ و عقیم‌شده باشد: ۳۹۴ × ۱٫۶ ≈ ۶۳۰ کیلوکالری در روز.</p>
  <table><thead><tr><th>وضعیت</th><th>ضریب سگ</th><th>ضریب گربه</th></tr></thead><tbody>
    <tr><td>بالغ عقیم‌شده</td><td>۱٫۶</td><td>۱٫۲</td></tr>
    <tr><td>بالغ عقیم‌نشده</td><td>۱٫۸</td><td>۱٫۴</td></tr>
    <tr><td>کم‌تحرک / مستعد چاقی</td><td>۱٫۲ تا ۱٫۴</td><td>۱٫۰</td></tr>
    <tr><td>کاهش وزن (بر اساس وزن ایده‌آل)</td><td>۱٫۰</td><td>۰٫۸</td></tr>
    <tr><td>فعال</td><td>۲٫۰</td><td>۱٫۶</td></tr>
    <tr><td>سگ کار / بسیار فعال</td><td>۳ تا ۵</td><td>—</td></tr>
    <tr><td>سالمند</td><td>حدود ۱٫۴</td><td>حدود ۱٫۱ (گاهی بیشتر)</td></tr>
    <tr><td>توله زیر ۴ ماه</td><td>۳٫۰</td><td rowspan="2">بچه‌گربه تا ۱۲ ماه: ۲٫۵</td></tr>
    <tr><td>توله ۴ ماه تا بزرگسالی</td><td>۲٫۰</td></tr>
  </tbody></table>
  <h3>۳. تبدیل کیلوکالری به گرم غذا</h3>
  <p>گرم روزانه = MER ÷ (کالری غذا بر کیلوگرم) × ۱۰۰۰. اگر غذای خشک شما ۳۵۰۰ کیلوکالری در کیلوگرم داشته باشد، ۶۳۰ کیلوکالری برابر حدود ۱۸۰ گرم در روز است. غذای مرطوب به دلیل ۷۵ تا ۸۰ درصد آب، کالری بسیار کمتری در هر گرم دارد (معمولاً ۸۰۰ تا ۱۲۰۰ کیلوکالری در کیلوگرم)؛ برای همین وزن غذای مرطوب لازم حدود سه تا چهار برابر غذای خشک است.</p>
  <h2>کالری غذای خشک و مرطوب چقدر است؟</h2>
  <ul>
    <li><strong>غذای خشک سگ:</strong> معمولاً ۳۲۰۰ تا ۴۰۰۰ کیلوکالری در کیلوگرم (غذاهای رژیمی کمتر، غذاهای توله و پرانرژی بیشتر). پیش‌فرض ماشین‌حساب: ۳۵۰۰.</li>
    <li><strong>غذای خشک گربه:</strong> معمولاً ۳۵۰۰ تا ۴۲۰۰ کیلوکالری در کیلوگرم. پیش‌فرض: ۳۸۰۰.</li>
    <li><strong>غذای مرطوب (کنسرو و پوچ):</strong> معمولاً ۷۰۰ تا ۱۳۰۰ کیلوکالری در کیلوگرم. پیش‌فرض: ۱۰۰۰.</li>
  </ul>
  <p>عدد دقیق را از روی بسته بخوانید؛ اگر بر حسب «kcal/100g» نوشته شده، آن را در ۱۰ ضرب کنید. اگر «kcal در هر پیمانه» نوشته شده، یک بار پیمانهٔ خود را با ترازوی آشپزخانه وزن کنید، چون پیمانه‌ها دقیق نیستند.</p>
  <h2>چطور بفهمیم مقدار غذا درست است؟</h2>
  <p>هر فرمول فقط یک <strong>نقطهٔ شروع</strong> است و نیاز واقعی حیوانات تا ۲۰ درصد بالا و پایین می‌رود. دو تا سه هفته با عدد محاسبه‌شده غذا بدهید و حیوان را هر دو هفته وزن کنید:</p>
  <ul>
    <li>در وضعیت بدنی ایده‌آل، دنده‌ها با لمس ملایم حس می‌شوند ولی دیده نمی‌شوند و از بالا کمر مشخص است.</li>
    <li>اگر وزن بالا می‌رود، مقدار را حدود ۱۰ درصد کم کنید؛ اگر حیوان لاغر می‌شود، ۱۰ درصد اضافه کنید.</li>
    <li>تشویقی‌ها، تکه‌های غذای سفره و جویدنی‌ها را هم حساب کنید و آن‌ها را زیر ۱۰ درصد کالری روزانه نگه دارید.</li>
    <li>آب تازه همیشه در دسترس باشد؛ به‌ویژه وقتی بیشتر جیره غذای خشک است.</li>
  </ul>
  <p>اگر برای گربه غذا درست می‌کنید، پیش از هر چیز <a href="/blog/cat-food-homemade/">اصول غذای گربه خانگی</a> را بخوانید، چون کالری درست به‌تنهایی کافی نیست و کمبود تورین و کلسیم خطرناک است. برای گربه‌های محله هم <a href="/blog/street-cat-food/">راهنمای غذای گربه‌های خیابانی</a> نکات مقدار و بهداشت را توضیح می‌دهد. در سگ‌های ریزنقش، چند ده گرم غذای اضافه سریع به چاقی می‌انجامد؛ نکات کنترل وزن را در <a href="/blog/small-dog-breeds/">نژاد سگ‌های کوچک آپارتمانی</a> ببینید. نژادهای کم‌تحرکی مثل <a href="/blog/persian-cat/">گربه پرشین</a> معمولاً به ضریب پایین‌تری نیاز دارند.</p>
  <h2>مرحلهٔ زندگی را درست انتخاب کنید</h2>
  <p>توله‌ها و بچه‌گربه‌ها در حال رشدند و به‌ازای هر کیلوگرم انرژی بسیار بیشتری لازم دارند؛ غذای آن‌ها هم باید مخصوص رشد باشد. در توله‌ها، وزن را هر هفته بسنجید و مقدار را با افزایش وزن به‌روز کنید. در سگ‌های نژاد بزرگ، رشد بیش از حد سریع به مفاصل آسیب می‌زند؛ پس غذای توله‌های نژاد بزرگ را دقیقاً طبق نظر دامپزشک بدهید. اگر مطمئن نیستید حیوان شما در کدام مرحله است، از <a href="/tools/dog-age/">محاسبه سن سگ به انسان</a> یا <a href="/tools/cat-age/">محاسبه سن گربه به انسان</a> کمک بگیرید.</p>
  <script is:inline>
  (function(){
    var fa=function(n){return String(n).replace(/\d/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'[d]}).replace('.','٫')};
    var $=function(id){return document.getElementById(id)};
    var STAGES={dog:[['adult','بالغ (۱ تا ۷ سال)'],['p1','توله زیر ۴ ماه'],['p2','توله ۴ ماه تا بزرگسالی'],['senior','سالمند (بسته به نژاد، از ۷ سالگی به بعد)']],
                cat:[['adult','بالغ (۱ تا ۱۰ سال)'],['kit','بچه‌گربه (تا ۱۲ ماه)'],['senior','سالمند (۱۱ سال به بالا)']]};
    var ACTS={dog:[['normal','معمولی (پیاده‌روی روزانه)'],['low','کم‌تحرک / مستعد چاقی'],['active','فعال (دویدن و بازی زیاد)'],['work','سگ کار / بسیار فعال'],['lose','برنامهٔ کاهش وزن']],
              cat:[['normal','معمولی (آپارتمانی)'],['low','کم‌تحرک / مستعد چاقی'],['active','فعال (رفت‌وآمد به بیرون)'],['lose','برنامهٔ کاهش وزن']]};
    var DEF={dog:{dry:3500,wet:1000},cat:{dry:3800,wet:1000}};
    function fill(sel,opts){sel.innerHTML=opts.map(function(o){return '<option value="'+o[0]+'">'+o[1]+'</option>'}).join('')}
    function factor(sp,st,neu,act){
      if(sp==='dog'){
        if(st==='p1') return [3.0,'توله زیر ۴ ماه'];
        if(st==='p2') return [2.0,'تولهٔ در حال رشد'];
        if(act==='lose') return [1.0,'کاهش وزن'];
        if(st==='senior') return act==='low'?[1.2,'سالمند کم‌تحرک']:(act==='active'||act==='work')?[1.6,'سالمند فعال']:[1.4,'سالمند'];
        if(act==='work') return [3.0,'سگ کار (بازهٔ ۳ تا ۵)'];
        if(act==='active') return [2.0,'بالغ فعال'];
        if(act==='low') return neu==='y'?[1.2,'بالغ عقیم‌شدهٔ کم‌تحرک']:[1.4,'بالغ کم‌تحرک'];
        return neu==='y'?[1.6,'بالغ عقیم‌شده']:[1.8,'بالغ عقیم‌نشده'];
      }
      if(st==='kit') return [2.5,'بچه‌گربهٔ در حال رشد'];
      if(act==='lose') return [0.8,'کاهش وزن'];
      if(st==='senior') return act==='low'?[1.0,'سالمند کم‌تحرک']:act==='active'?[1.3,'سالمند فعال']:[1.1,'سالمند'];
      if(act==='low') return [1.0,'بالغ کم‌تحرک / مستعد چاقی'];
      if(act==='active') return [1.6,'بالغ فعال'];
      return neu==='y'?[1.2,'بالغ عقیم‌شده']:[1.4,'بالغ عقیم‌نشده'];
    }
    var kcalTouched=false;
    function setSpecies(){var sp=$('fsp').value;fill($('fst'),STAGES[sp]);fill($('fact'),ACTS[sp]);setDefault();}
    function setDefault(){if(!kcalTouched){$('fkcal').value=DEF[$('fsp').value][$('ftype').value];}}
    function run(){
      var sp=$('fsp').value, kg=parseFloat(String($('fkg').value).replace(/[۰-۹]/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d)}))||0;
      var st=$('fst').value, neu=$('fneu').value, act=$('fact').value, kc=+$('fkcal').value||0, meals=+$('fmeals').value||1;
      var growth=(st==='p1'||st==='p2'||st==='kit');
      $('fneu').disabled=growth; $('fact').disabled=growth;
      if(kg<=0||kg>100||kc<300){ $('fgram').textContent='—'; $('fmeal').textContent='وزن (۰٫۳ تا ۱۰۰ کیلو) و کالری غذا (دست‌کم ۳۰۰) را درست وارد کنید.'; $('fkc').textContent=''; $('fdet').textContent=''; return; }
      var rer=70*Math.pow(kg,0.75), f=factor(sp,st,neu,act), mer=rer*f[0], g=mer/kc*1000;
      var r=function(x){return x>=100?Math.round(x/5)*5:Math.round(x)};
      $('fgram').textContent=fa(r(g))+' گرم';
      $('fmeal').textContent=meals>1?('تقریباً '+fa(r(g/meals))+' گرم در هر وعده ('+fa(meals)+' وعده)'):'در یک وعده';
      $('fkc').textContent='نیاز انرژی روزانه (MER): حدود '+fa(Math.round(mer))+' کیلوکالری · بازهٔ معقول: '+fa(r(g*0.9))+' تا '+fa(r(g*1.1))+' گرم';
      $('fdet').textContent='RER = ۷۰ × '+fa(kg)+'^۰٫۷۵ ≈ '+fa(Math.round(rer))+' کیلوکالری · ضریب '+fa(f[0].toFixed(1))+' ('+f[1]+')';
      $('fhint').textContent=act==='lose'&&!growth?'در برنامهٔ کاهش وزن، وزن ایده‌آل (نه وزن فعلی) را وارد کنید و رژیم را با نظارت دامپزشک شروع کنید.':growth?'برای توله و بچه‌گربه، ضریب رشد جای عقیم‌سازی و فعالیت را می‌گیرد؛ وزن را هر هفته به‌روز کنید.':'';
      $('fdet').setAttribute('data-mer',Math.round(mer)); $('fdet').setAttribute('data-rer',Math.round(rer)); $('fdet').setAttribute('data-factor',f[0]);
    }
    $('fsp').addEventListener('change',function(){setSpecies();run()});
    $('ftype').addEventListener('change',function(){kcalTouched=false;setDefault();run()});
    $('fkcal').addEventListener('input',function(){kcalTouched=true;run()});
    ['fkg','fst','fneu','fact','fmeals'].forEach(function(id){$(id).addEventListener('input',run);$(id).addEventListener('change',run)});
    setSpecies(); run();
  })();
  </script>
</Tool>
