---
import Tool from '../../layouts/Tool.astro';
const faq = [
  { q: 'هر سال گربه چند سال انسان است؟', a: 'نسبت ثابتی وجود ندارد. سال اول زندگی گربه تقریباً معادل ۱۵ سال انسان، سال دوم حدود ۹ سال دیگر (جمعاً ۲۴) و از آن به بعد هر سال تقریباً ۴ سال انسانی است. بنابراین فرمول «ضرب در ۷» برای گربه دقیق نیست.' },
  { q: 'گربه از چه سنی سالمند حساب می‌شود؟', a: 'طبق راهنمای مراحل زندگی AAFP، گربه‌ها از حدود ۱۰ سالگی در مرحلهٔ «سالمند» قرار می‌گیرند. از این سن به بعد معاینهٔ دوره‌ای هر شش ماه یک بار و آزمایش خون منظم توصیه می‌شود.' },
  { q: 'اگر تاریخ تولد گربه را ندانم چطور سنش را بفهمم؟', a: 'دامپزشک با بررسی دندان‌ها (رویش دندان‌های دائمی تا حدود ۶ ماهگی، میزان جرم و ساییدگی)، شفافیت عدسی چشم، وضعیت عضلات و پوشش مو سن تقریبی را برآورد می‌کند. این برآورد برای گربه‌های بالغ معمولاً بازه‌ای چندساله است.' },
  { q: 'آیا گربه‌های خانگی بیشتر از گربه‌های بیرون عمر می‌کنند؟', a: 'به طور کلی بله. گربه‌هایی که فقط در خانه زندگی می‌کنند کمتر در معرض تصادف، دعوا، بیماری‌های عفونی و سموم‌اند و معمولاً ۱۲ تا ۱۸ سال یا بیشتر عمر می‌کنند.' },
  { q: 'این ماشین‌حساب چقدر دقیق است؟', a: 'این ابزار بر اساس جدول رایج مراحل زندگی گربه (AAFP/AAHA) کار می‌کند و یک تخمین آموزشی است. سرعت پیری هر گربه به نژاد، ژنتیک، تغذیه و سلامتش بستگی دارد.' },
];
const links = [['/blog/cat-food-homemade/','غذای گربه خانگی'],['/blog/persian-cat/','راهنمای گربه پرشین'],['/blog/scottish-fold-cat/','گربه اسکاتیش فولد'],['/blog/street-cat-food/','غذای گربه‌های خیابانی'],['/tools/dog-age/','محاسبه سن سگ به انسان']];
---
<Tool title="محاسبه سن گربه به انسان (ماشین‌حساب دقیق + جدول)" h1="محاسبه سن گربه به انسان" description="سن گربه‌تان به سال انسانی چقدر است؟ با ماشین‌حساب رایگان همدم سن گربه نسبت به انسان و مرحلهٔ زندگی‌اش را بفهمید؛ همراه جدول کامل و توضیح علمی." slug="cat-age" illo="cat-age" faq={faq} links={links}>
  <div slot="calc" class="calc" id="catcalc">
    <div class="row">
      <div><label for="cy">سن (سال)</label><input id="cy" type="number" min="0" max="30" value="3" inputmode="numeric" /></div>
      <div><label for="cm">ماه</label><input id="cm" type="number" min="0" max="11" value="0" inputmode="numeric" /></div>
    </div>
    <label for="life">سبک زندگی</label>
    <select id="life"><option value="in">فقط داخل خانه</option><option value="out">رفت‌وآمد به بیرون</option></select>
    <div class="result" aria-live="polite"><div>معادل سن انسانی</div><div class="big" id="cout">۲۸ سال</div><div id="cstage"></div></div>
  </div>
  <p>گربه‌ها در دو سال اول زندگی با سرعت شگفت‌انگیزی بزرگ می‌شوند: بچه‌گربهٔ یک‌ساله از نظر رشد جسمی و جنسی تقریباً به یک نوجوان ۱۵ ساله شبیه است. پس از آن سرعت پیری کند می‌شود. به همین دلیل قانون قدیمی «هر سال گربه برابر هفت سال انسان» تصویر اشتباهی می‌دهد. ماشین‌حساب بالا از روش پذیرفته‌شده در راهنمای مراحل زندگی گربه (AAFP و AAHA) استفاده می‌کند.</p>
  <h2>فرمول محاسبه سن گربه نسبت به انسان</h2>
  <ul><li><strong>سال اول:</strong> حدود ۱۵ سال انسانی (۱ ماهگی ≈ ۱ سال، ۳ ماهگی ≈ ۴ سال، ۶ ماهگی ≈ ۱۰ سال).</li><li><strong>سال دوم:</strong> ۹ سال دیگر؛ گربهٔ دوساله ≈ ۲۴ سال انسان.</li><li><strong>از سال سوم به بعد:</strong> هر سال حدود ۴ سال انسانی.</li></ul>
  <p>یعنی سن انسانی ≈ ۲۴ + ۴ × (سن گربه − ۲). برای سنین زیر دو سال، ماشین‌حساب بین نقاط جدول درون‌یابی می‌کند.</p>
  <h2>جدول سن گربه به انسان</h2>
  <table><thead><tr><th>سن گربه</th><th>سن معادل انسان</th><th>مرحلهٔ زندگی</th></tr></thead><tbody>
  <tr><td>۱ ماه</td><td>۱ سال</td><td rowspan="3">بچه‌گربه (تا ۱ سالگی)</td></tr><tr><td>۳ ماه</td><td>۴ سال</td></tr><tr><td>۶ ماه</td><td>۱۰ سال</td></tr>
  <tr><td>۱ سال</td><td>۱۵ سال</td><td rowspan="2">جوان (۱ تا ۶ سال)</td></tr><tr><td>۲ سال</td><td>۲۴ سال</td></tr>
  <tr><td>۴ سال</td><td>۳۲ سال</td><td>جوان</td></tr><tr><td>۶ سال</td><td>۴۰ سال</td><td>جوان</td></tr>
  <tr><td>۸ سال</td><td>۴۸ سال</td><td>بالغ (۷ تا ۱۰ سال)</td></tr><tr><td>۱۰ سال</td><td>۵۶ سال</td><td>بالغ / آغاز سالمندی</td></tr>
  <tr><td>۱۲ سال</td><td>۶۴ سال</td><td>سالمند</td></tr><tr><td>۱۵ سال</td><td>۷۶ سال</td><td>سالمند</td></tr><tr><td>۱۸ سال</td><td>۸۸ سال</td><td>سالمند</td></tr><tr><td>۲۰ سال</td><td>۹۶ سال</td><td>سالمند</td></tr>
  </tbody></table>
  <h2>مراحل زندگی گربه و نیازهای هر مرحله</h2>
  <h3>بچه‌گربه (تولد تا ۱ سالگی)</h3>
  <p>دورهٔ رشد سریع، واکسیناسیون پایه، ضدانگل و اجتماعی‌شدن. بچه‌گربه به غذای مخصوص رشد با انرژی و پروتئین بیشتر نیاز دارد. برنامهٔ واکسن را دامپزشک بر اساس شرایط زندگی گربه تنظیم می‌کند.</p>
  <h3>جوان (۱ تا ۶ سال)</h3>
  <p>اوج انرژی و سلامت. معاینهٔ سالانه، کنترل وزن، بازی روزانه و مراقبت از دندان‌ها اهمیت دارد. اگر برای گربه غذا درست می‌کنید، حتماً <a href="/blog/cat-food-homemade/">اصول غذای گربه خانگی</a> را رعایت کنید تا کمبود تورین پیش نیاید.</p>
  <h3>بالغ (۷ تا ۱۰ سال)</h3>
  <p>متابولیسم کندتر می‌شود و خطر چاقی، بیماری دندان و دیابت بالا می‌رود. تغییر تدریجی جیره و توجه به میزان آب‌خوردن را جدی بگیرید.</p>
  <h3>سالمند (۱۰ سال به بالا)</h3>
  <p>بیماری کلیه، پرکاری تیروئید، آرتروز و فشار خون در این دوره شایع‌ترند. معاینهٔ هر شش ماه، آزمایش خون و ادرار، و آسان کردن دسترسی به ظرف خاک و جای خواب کمک بزرگی است. تغییر رفتار، کاهش وزن یا پرنوشی را نشانهٔ پیری «عادی» ندانید و به دامپزشک اطلاع دهید.</p>
  <h2>چه چیزهایی روی طول عمر گربه اثر دارد؟</h2>
  <p>نژاد (برخی نژادها مثل <a href="/blog/persian-cat/">گربه پرشین</a> و <a href="/blog/scottish-fold-cat/">اسکاتیش فولد</a> مستعد مشکلات ارثی‌اند)، عقیم‌سازی، نگهداری در خانه، وزن مناسب، تغذیهٔ کامل و مراقبت پیشگیرانه بیشترین اثر را دارند. گربه‌های خیابانی به‌دلیل خطرات محیطی عمر کوتاه‌تری دارند؛ اگر به آن‌ها غذا می‌دهید <a href="/blog/street-cat-food/">راهنمای غذای گربه‌های خیابانی</a> را بخوانید.</p>
  <script is:inline>
  (function(){
    var fa=function(n){return String(n).replace(/\d/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'[d]}).replace('.','٫')};
    var pts=[[0,0],[1,1],[2,2],[3,4],[4,6],[6,10],[8,12],[12,15],[18,21],[24,24]];
    function human(m){ if(m>=24) return 24+4*(m-24)/12; for(var i=1;i<pts.length;i++){ if(m<=pts[i][0]){var a=pts[i-1],b=pts[i];return a[1]+(b[1]-a[1])*(m-a[0])/(b[0]-a[0]);} } }
    function stage(y){ return y<1?'بچه‌گربه':y<7?'جوان (اوج سلامت)':y<10?'بالغ':'سالمند (معاینهٔ هر ۶ ماه توصیه می‌شود)'; }
    function run(){ var y=Math.max(0,+document.getElementById('cy').value||0), mo=Math.min(11,Math.max(0,+document.getElementById('cm').value||0));
      var m=y*12+mo, h=Math.round(human(m)), life=document.getElementById('life').value;
      document.getElementById('cout').textContent=fa(h)+' سال';
      document.getElementById('cstage').textContent='مرحلهٔ زندگی: '+stage(m/12)+(life==='out'?' — گربه‌های بیرون‌رو در معرض خطرات بیشتری‌اند؛ واکسن و ضدانگل منظم را جدی بگیرید.':''); }
    ['cy','cm','life'].forEach(function(id){document.getElementById(id).addEventListener('input',run)}); run();
  })();
  </script>
</Tool>
