---
import Tool from '../../layouts/Tool.astro';
const faq = [
  { q: 'آیا هر سال سگ برابر ۷ سال انسان است؟', a: 'خیر. این قانون ساده‌سازی قدیمی است. سگ‌ها در یکی دو سال اول خیلی سریع بالغ می‌شوند و بعد سرعت پیری‌شان به اندازهٔ بدن بستگی دارد: سگ‌های کوچک کندتر و سگ‌های بزرگ و غول‌پیکر سریع‌تر پیر می‌شوند.' },
  { q: 'چرا سگ‌های بزرگ عمر کوتاه‌تری دارند؟', a: 'هنوز علت قطعی آن روشن نیست، اما مطالعات نشان می‌دهد نژادهای بزرگ سریع‌تر رشد و پیر می‌شوند و بیماری‌های مرتبط با سن در آن‌ها زودتر ظاهر می‌شود. به همین دلیل یک سگ گریت دین ۷ ساله سالمند است، در حالی که یک شیتزو ۷ ساله هنوز میانسال حساب می‌شود.' },
  { q: 'فرمول لگاریتمی سن سگ چیست؟', a: 'پژوهشی در سال ۲۰۲۰ بر اساس تغییرات اپی‌ژنتیک DNA در سگ‌های لابرادور فرمول «۱۶ × لگاریتم طبیعی سن سگ + ۳۱» را پیشنهاد کرد. این فرمول فقط روی یک نژاد بررسی شده و برای سنین بسیار پایین مناسب نیست؛ ما آن را به‌عنوان عدد دوم و صرفاً برای مقایسه نشان می‌دهیم.' },
  { q: 'سگ از چه سنی سالمند است؟', a: 'به‌طور تقریبی نژادهای کوچک از حدود ۱۰ سالگی، نژادهای متوسط از ۸ سالگی، نژادهای بزرگ از ۷ سالگی و نژادهای غول‌پیکر از ۵ تا ۶ سالگی وارد دورهٔ سالمندی می‌شوند. از این زمان معاینهٔ دوره‌ای هر ۶ ماه توصیه می‌شود.' },
  { q: 'سگم دورگه است؛ کدام اندازه را انتخاب کنم؟', a: 'بر اساس وزن بزرگسالی سگ انتخاب کنید: کوچک تا ۹ کیلوگرم، متوسط ۱۰ تا ۲۳، بزرگ ۲۴ تا ۴۰ و غول‌پیکر بیش از ۴۰ کیلوگرم.' },
];
const links = [['/blog/dog-vaccine-schedule/','جدول واکسن سگ'],['/blog/parvo-in-dogs/','بیماری پاروا در سگ'],['/blog/small-dog-breeds/','نژاد سگ‌های کوچک آپارتمانی'],['/tools/cat-age/','محاسبه سن گربه به انسان']];
---
<Tool title="محاسبه سن سگ به انسان بر اساس نژاد و وزن" h1="محاسبه سن سگ به انسان" description="ماشین‌حساب رایگان سن سگ به انسان بر اساس اندازهٔ نژاد؛ دقیق‌تر از ضرب در ۷. همراه جدول سن سگ‌های کوچک، متوسط، بزرگ و غول‌پیکر و نشانه‌های سالمندی." slug="dog-age" illo="dog-age" faq={faq} links={links}>
  <div slot="calc" class="calc">
    <div class="row">
      <div><label for="dy">سن (سال)</label><input id="dy" type="number" min="0" max="30" value="5" inputmode="numeric" /></div>
      <div><label for="dm">ماه</label><input id="dm" type="number" min="0" max="11" value="0" inputmode="numeric" /></div>
    </div>
    <label for="size">اندازهٔ نژاد (وزن بزرگسالی)</label>
    <select id="size"><option value="s">کوچک (تا ۹ کیلو) — شیتزو، پامرانین، چیواوا</option><option value="m" selected>متوسط (۱۰ تا ۲۳ کیلو) — بیگل، کوکر اسپانیل</option><option value="l">بزرگ (۲۴ تا ۴۰ کیلو) — ژرمن شپرد، لابرادور، هاسکی</option><option value="g">غول‌پیکر (بیش از ۴۰ کیلو) — گریت دین، سرابی، ماستیف</option></select>
    <div class="result" aria-live="polite"><div>معادل سن انسانی</div><div class="big" id="dout"></div><div id="dstage"></div><div id="dlog" style="opacity:.8;font-size:.9rem"></div></div>
  </div>
  <p>تبدیل سن سگ به انسان به اندازهٔ سگ بستگی دارد. یک سگ یک‌ساله، از هر نژادی، تقریباً هم‌ارز یک نوجوان ۱۴ تا ۱۵ ساله است؛ اما از سال سوم به بعد سگ‌های بزرگ‌تر سریع‌تر پیر می‌شوند. ماشین‌حساب همدم از جدول رایج دامپزشکی (برگرفته از نمودارهای AVMA/AKC) استفاده می‌کند و فرمول اپی‌ژنتیک ۲۰۲۰ را هم برای مقایسه نشان می‌دهد.</p>
  <h2>روش محاسبه</h2>
  <ul><li><strong>سال اول:</strong> کوچک و متوسط ≈ ۱۵، بزرگ ≈ ۱۴ و غول‌پیکر ≈ ۱۲ سال انسانی.</li><li><strong>سال دوم:</strong> کوچک و متوسط ≈ ۲۴، بزرگ و غول‌پیکر ≈ ۲۲ سال.</li><li><strong>هر سال بعد:</strong> کوچک ۴، متوسط ۵، بزرگ ۶ و غول‌پیکر حدود ۷ سال انسانی.</li></ul>
  <h2>جدول سن سگ به انسان</h2>
  <table><thead><tr><th>سن سگ</th><th>کوچک</th><th>متوسط</th><th>بزرگ</th><th>غول‌پیکر</th></tr></thead><tbody>
  <tr><td>۱</td><td>۱۵</td><td>۱۵</td><td>۱۴</td><td>۱۲</td></tr><tr><td>۲</td><td>۲۴</td><td>۲۴</td><td>۲۲</td><td>۲۲</td></tr>
  <tr><td>۴</td><td>۳۲</td><td>۳۴</td><td>۳۴</td><td>۳۶</td></tr><tr><td>۶</td><td>۴۰</td><td>۴۴</td><td>۴۶</td><td>۵۰</td></tr>
  <tr><td>۸</td><td>۴۸</td><td>۵۴</td><td>۵۸</td><td>۶۴</td></tr><tr><td>۱۰</td><td>۵۶</td><td>۶۴</td><td>۷۰</td><td>۷۸</td></tr>
  <tr><td>۱۲</td><td>۶۴</td><td>۷۴</td><td>۸۲</td><td>۹۲</td></tr><tr><td>۱۴</td><td>۷۲</td><td>۸۴</td><td>۹۴</td><td>—</td></tr><tr><td>۱۶</td><td>۸۰</td><td>۹۴</td><td>—</td><td>—</td></tr>
  </tbody></table>
  <p class="meta">اعداد تقریبی و آموزشی‌اند؛ بین منابع مختلف چند سال تفاوت دیده می‌شود.</p>
  <h2>چرا فرمول «ضرب در ۷» غلط است؟</h2>
  <p>اگر سن سگ یک‌ساله را در ۷ ضرب کنیم به «کودک ۷ ساله» می‌رسیم، در حالی که سگ یک‌ساله بالغ جنسی است و می‌تواند تولیدمثل کند. از طرف دیگر، یک چیواوای ۱۵ ساله با ضرب در ۷ «۱۰۵ ساله» می‌شود که با سلامت معمول این سگ‌ها نمی‌خواند. منحنی واقعی پیری سگ در ابتدا تند و بعد ملایم‌تر است و شیب آن به اندازهٔ بدن بستگی دارد.</p>
  <h2>مراحل زندگی سگ</h2>
  <h3>توله (تا ۶ تا ۱۲ ماهگی)</h3><p>واکسیناسیون پایه، ضدانگل، اجتماعی‌شدن و آموزش اولیه در این دوره انجام می‌شود. برنامهٔ دقیق را در <a href="/blog/dog-vaccine-schedule/">جدول واکسن سگ</a> ببینید و بدانید چرا <a href="/blog/parvo-in-dogs/">پاروا</a> برای توله‌های واکسن‌نزده خطرناک است.</p>
  <h3>جوان و بالغ</h3><p>تا زمانی که رشد کامل شود (در نژادهای کوچک حدود ۱ سال و در نژادهای غول‌پیکر تا ۱۸ تا ۲۴ ماه) به غذای مخصوص رشد نیاز دارد. سپس تمرکز بر ورزش روزانه، کنترل وزن، بهداشت دهان و یادآورهای واکسن است.</p>
  <h3>سالمند</h3><p>کاهش انرژی، سفیدی پوزه، سفتی مفاصل، کدر شدن چشم و تغییر در ادرار و تشنگی شایع می‌شود. هر تغییر ناگهانی (مثل افزایش تشنگی، کاهش وزن یا توده‌های جدید) را با دامپزشک در میان بگذارید.</p>
  <h2>انتخاب نژاد و طول عمر</h2>
  <p>اگر هنوز سگ ندارید و برای آپارتمان دنبال گزینه‌اید، نژادهای کوچک معمولاً عمر طولانی‌تری دارند؛ <a href="/blog/small-dog-breeds/">فهرست نژاد سگ‌های کوچک</a> را با نکات سلامتی هر نژاد بخوانید.</p>
  <script is:inline>
  (function(){
    var fa=function(n){return String(n).replace(/\d/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'[d]})};
    var P={s:[15,24,4,10],m:[15,24,5,8],l:[14,22,6,7],g:[12,22,7,5.5]};
    function human(y,s){var p=P[s]; if(y<=1) return p[0]*y; if(y<=2) return p[0]+(p[1]-p[0])*(y-1); return p[1]+p[2]*(y-2);}
    function run(){ var y=Math.max(0,+document.getElementById('dy').value||0)+Math.min(11,Math.max(0,+document.getElementById('dm').value||0))/12, s=document.getElementById('size').value;
      document.getElementById('dout').textContent=fa(Math.round(human(y,s)))+' سال';
      var st=y<1?'توله':y<P[s][3]?'بالغ':'سالمند (معاینهٔ هر ۶ ماه توصیه می‌شود)';
      document.getElementById('dstage').textContent='مرحلهٔ زندگی: '+st;
      document.getElementById('dlog').textContent=y>=1?'فرمول اپی‌ژنتیک (۲۰۲۰، لابرادور): حدود '+fa(Math.round(16*Math.log(y)+31))+' سال':''; }
    ['dy','dm','size'].forEach(function(id){document.getElementById(id).addEventListener('input',run)}); run();
  })();
  </script>
</Tool>
