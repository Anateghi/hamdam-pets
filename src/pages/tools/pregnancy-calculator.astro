---
import Tool from '../../layouts/Tool.astro';
import JalaliDate from '../../components/JalaliDate.astro';
const faq = [
  { q: 'دوران بارداری سگ چند روز است؟', a: 'به‌طور میانگین حدود ۶۳ روز (۹ هفته). اما چون اسپرم چند روز در بدن ماده زنده می‌ماند و جفت‌گیری لزوماً هم‌زمان با تخمک‌گذاری نیست، زایمان از تاریخ جفت‌گیری می‌تواند بین ۵۸ تا ۷۲ روز باشد (کتاب دامپزشکی Merck). اگر تاریخ تخمک‌گذاری با آزمایش پروژسترون مشخص شده باشد، زایمان ۶۲ تا ۶۴ روز بعد و از اوج LH، ۶۴ تا ۶۶ روز بعد است.' },
  { q: 'بارداری گربه چند روز طول می‌کشد؟', a: 'معمولاً ۶۳ تا ۶۷ روز از جفت‌گیری، با میانگین حدود ۶۵ روز. گربه تخمک‌گذاری القایی دارد (تخمک‌گذاری ۲۴ تا ۴۸ ساعت پس از جفت‌گیری رخ می‌دهد)، برای همین تاریخ جفت‌گیری در گربه پیش‌بینی نسبتاً خوبی است. زایمان پیش از روز ۶۰ معمولاً زودرس است.' },
  { q: 'از کجا بفهمم سگ یا گربه‌ام باردار است؟', a: 'تشخیص قطعی با دامپزشک است: سونوگرافی از حدود روز ۲۵ در سگ و روز ۱۶ تا ۱۸ در گربه ضربان قلب جنین را نشان می‌دهد. آزمایش خون ریلکسین در سگ از حدود روز ۲۵ به بعد مثبت می‌شود. نشانه‌های ظاهری مثل صورتی شدن نوک پستان‌ها (گربه، حدود هفتهٔ سوم) و بزرگ شدن شکم دیرتر و کمتر قابل اعتمادند؛ بارداری کاذب هم در سگ شایع است.' },
  { q: 'نشانه‌های شروع زایمان سگ چیست؟', a: 'بی‌قراری، لانه‌سازی، کم‌اشتهایی، لرز و نفس‌نفس زدن. در سگ‌ها دمای مقعدی حدود ۸ تا ۲۴ ساعت پیش از زایمان به زیر حدود ۳۷٫۸ درجهٔ سانتی‌گراد افت می‌کند. اگر سگ بیش از ۳۰ دقیقه زور شدید بزند و توله‌ای به دنیا نیاید، بین دو توله بیش از ۲ تا ۴ ساعت فاصله بیفتد، یا ترشح سبز تیره پیش از اولین توله ببینید، فوراً با دامپزشک تماس بگیرید.' },
  { q: 'اگر از تاریخ پیش‌بینی‌شده گذشت چه کنم؟', a: 'اگر از بیشترین بازه (۷۲ روز از اولین جفت‌گیری در سگ، حدود ۷۰ تا ۷۲ روز در گربه) گذشت یا حیوان علائم ناخوشی دارد، بی‌درنگ به دامپزشک مراجعه کنید. دامپزشک با سونوگرافی ضربان قلب جنین‌ها را بررسی می‌کند و دربارهٔ القای زایمان یا سزارین تصمیم می‌گیرد.' },
  { q: 'به سگ یا گربهٔ باردار چه غذایی بدهم؟', a: 'تا حدود هفتهٔ پنجم معمولاً همان غذای بالغ کافی است؛ از آن به بعد نیاز انرژی بالا می‌رود و بیشتر دامپزشکان غذای کامل مخصوص رشد (توله یا بچه‌گربه) را توصیه می‌کنند که تا پایان شیردهی ادامه پیدا می‌کند. مکمل کلسیم را بدون نظر دامپزشک ندهید، چون خطر تشنج پس از زایمان (اکلامپسی) را بیشتر می‌کند.' },
];
const links = [['/tools/vaccine-schedule/','برنامه‌ساز واکسن توله و بچه‌گربه'],['/tools/food-calculator/','محاسبه مقدار غذای سگ و گربه'],['/blog/dog-vaccine-schedule/','جدول واکسن سگ'],['/blog/persian-cat/','راهنمای گربه پرشین'],['/blog/small-dog-breeds/','نژاد سگ‌های کوچک آپارتمانی'],['/tools/ideal-weight/','وزن ایده‌آل سگ و گربه']];
---
<Tool title="محاسبه زمان زایمان سگ و گربه (تاریخ شمسی)" h1="محاسبه زمان زایمان و تقویم بارداری سگ و گربه" description="تاریخ جفت‌گیری را به شمسی وارد کنید تا تاریخ تقریبی زایمان سگ یا گربه، بازهٔ طبیعی، روز و هفتهٔ فعلی بارداری و تقویم سونوگرافی و آمادگی زایمان را ببینید." slug="pregnancy-calculator" illo="dog" faq={faq} links={links}>
  <div slot="calc" class="calc" id="pcalc">
    <div class="row">
      <div><label for="psp">حیوان</label><select id="psp"><option value="dog">سگ</option><option value="cat">گربه</option></select></div>
      <div><label for="pref">تاریخ مبنا</label><select id="pref"></select></div>
    </div>
    <JalaliDate id="pdate" label="تاریخ (شمسی)" />
    <div class="result" aria-live="polite"><div>تاریخ تقریبی زایمان</div><div class="big" id="pdue">—</div><div class="sub" id="prange"></div><div class="sub" id="pnow" style="margin-top:6px"></div></div>
    <div class="actions noprint"><button class="btn sec" type="button" id="pprint">چاپ تقویم بارداری</button></div>
    <div style="overflow-x:auto"><table class="sched" id="ptable"><thead><tr><th>تاریخ (شمسی)</th><th>روز بارداری</th><th>چه اتفاقی می‌افتد / چه کنیم</th></tr></thead><tbody></tbody></table></div>
  </div>
  <p>«سگم کی زایمان می‌کند؟» یا «بارداری گربه چند روز است؟» سؤال‌هایی‌اند که معمولاً چند هفته بعد از یک جفت‌گیری برنامه‌ریزی‌شده یا اتفاقی پیش می‌آیند. این ماشین‌حساب از تاریخ جفت‌گیری (یا در سگ، تاریخ اوج LH یا تخمک‌گذاری که با آزمایش خون مشخص شده)، تاریخ تقریبی زایمان، بازهٔ طبیعی و یک <strong>تقویم بارداری شمسی</strong> شامل زمان سونوگرافی، رادیوگرافی، تغییر غذا و آماده‌سازی جای زایمان را می‌سازد. اعداد از <strong>کتاب دامپزشکی Merck</strong> و مقالات مرور تولیدمثل سگ و گربه گرفته شده‌اند.</p>
  <h2>طول بارداری سگ و گربه</h2>
  <table><thead><tr><th>مبنا</th><th>سگ</th><th>گربه</th></tr></thead><tbody>
    <tr><td>از اولین جفت‌گیری</td><td>میانگین ۶۳ روز؛ بازهٔ ۵۸ تا ۷۲ روز</td><td>میانگین حدود ۶۵ روز؛ بیشتر ۶۳ تا ۶۷ روز</td></tr>
    <tr><td>از اوج هورمون LH</td><td>۶۴ تا ۶۶ روز</td><td>۶۴ تا ۶۶ روز (LH بلافاصله پس از جفت‌گیری)</td></tr>
    <tr><td>از تخمک‌گذاری</td><td>۶۲ تا ۶۴ روز</td><td>—</td></tr>
  </tbody></table>
  <p>چرا بازهٔ سگ این‌قدر بزرگ است؟ سگ ماده ممکن است چند روز پیش یا پس از تخمک‌گذاری جفت‌گیری کند و اسپرم تا یک هفته در بدن او زنده می‌ماند؛ پس تاریخ جفت‌گیری دقیقاً تاریخ لقاح نیست. اگر برای سگتان آزمایش پروژسترون انجام شده، مبنای «تخمک‌گذاری» را انتخاب کنید تا پیش‌بینی به ۱ تا ۲ روز دقت برسد. در گربه وضع ساده‌تر است، چون تخمک‌گذاری با خود جفت‌گیری القا می‌شود. تعداد توله‌ها هم اثر دارد: در سگ‌ها بارداری با تعداد کم توله معمولاً کمی طولانی‌تر است.</p>
  <h2>مراحل بارداری هفته به هفته (خلاصه)</h2>
  <ul>
    <li><strong>هفتهٔ ۱ تا ۳:</strong> لقاح و لانه‌گزینی. معمولاً تغییری دیده نمی‌شود؛ برخی سگ‌ها کمی تهوع یا کم‌اشتهایی دارند.</li>
    <li><strong>هفتهٔ ۴:</strong> زمان طلایی سونوگرافی برای تأیید بارداری و دیدن ضربان قلب جنین‌ها.</li>
    <li><strong>هفتهٔ ۵ و ۶:</strong> وزن و اشتها بالا می‌رود؛ تغییر تدریجی به غذای رشد.</li>
    <li><strong>هفتهٔ ۷ و ۸:</strong> حرکت توله‌ها گاهی از روی شکم حس می‌شود؛ رادیوگرافی برای شمارش.</li>
    <li><strong>هفتهٔ ۹:</strong> لانه‌سازی، کم‌اشتهایی و افت دمای بدن پیش از زایمان.</li>
  </ul>
  <h2>چه زمانی فوراً به دامپزشک زنگ بزنیم؟</h2>
  <ul>
    <li>زور زدن شدید و مداوم بیش از ۳۰ دقیقه بدون تولد نوزاد.</li>
    <li>فاصلهٔ بیش از ۲ تا ۴ ساعت بین دو نوزاد در حالی که می‌دانید نوزاد دیگری مانده است.</li>
    <li>ترشح سبز تیره یا خونی زیاد پیش از تولد اولین نوزاد، یا ترشح بدبو.</li>
    <li>گذشتن از انتهای بازهٔ طبیعی بارداری، تب، بی‌حالی شدید یا لرزش و تشنج (نشانهٔ احتمالی اکلامپسی) پس از زایمان.</li>
  </ul>
  <p>پس از زایمان، برنامهٔ واکسن و ضدانگل نوزادها را با <a href="/tools/vaccine-schedule/">برنامه‌ساز واکسن توله و بچه‌گربه</a> بسازید و مقدار غذای مادر شیرده را با دامپزشک تنظیم کنید؛ <a href="/tools/food-calculator/">ماشین‌حساب غذا</a> برای حیوان باردار یا شیرده طراحی نشده است. اگر بارداری برنامه‌ریزی‌نشده بود، دربارهٔ عقیم‌سازی پس از دورهٔ شیردهی با دامپزشک صحبت کنید؛ میلیون‌ها سگ و گربهٔ بی‌سرپناه منتظر خانه‌اند.</p>
  <script>
    import { jalaliPicker, fmtJ, fa, today, addDays, daysBetween } from '../../scripts/jalali.js';
    import { REF, calc } from '../../scripts/pregnancy.js';
    const $ = (id) => document.getElementById(id);
    const pick = jalaliPicker($('pdate'), addDays(today(), -30));
    function fillRef() { const sp = $('psp').value; $('pref').innerHTML = Object.entries(REF[sp]).map(([k, v]) => `<option value="${k}">${v.label}</option>`).join(''); }
    function run() {
      const sp = $('psp').value, ref = $('pref').value, d = pick.get(), tb = $('ptable').querySelector('tbody');
      if (!d) { $('pdue').textContent = '—'; $('prange').textContent = 'تاریخ معتبر وارد کنید.'; tb.innerHTML = ''; return; }
      const r = calc(sp, ref, d), t = today(), day = daysBetween(d, t);
      $('pdue').textContent = fmtJ(r.due, true); $('pdue').dataset.iso = r.due.toISOString().slice(0, 10);
      $('prange').textContent = (ref === 'mating' ? 'بیشتر زایمان‌ها بین ' + fmtJ(r.typLo) + ' تا ' + fmtJ(r.typHi) + ' · ' : '') + 'بازهٔ طبیعی: ' + fmtJ(r.lo) + ' تا ' + fmtJ(r.hi) + ' (روز ' + fa(r.r.lo) + ' تا ' + fa(r.r.hi) + ')';
      if (day < 0) $('pnow').textContent = 'تاریخ واردشده در آینده است.';
      else if (t > r.hi) $('pnow').textContent = 'از انتهای بازهٔ طبیعی گذشته‌اید (روز ' + fa(day) + '). اگر زایمان نکرده، همین امروز با دامپزشک تماس بگیرید.';
      else $('pnow').textContent = 'امروز روز ' + fa(day) + ' بارداری است (هفتهٔ ' + fa(Math.floor(day / 7) + 1) + ') · ' + (daysBetween(t, r.due) > 0 ? fa(daysBetween(t, r.due)) + ' روز تا تاریخ تقریبی زایمان' : 'در محدودهٔ زایمان هستید؛ آماده باشید');
      const rows = r.milestones.map((m) => ({ ...m })).concat([{ date: r.lo, day: r.r.lo, text: 'شروع بازهٔ طبیعی زایمان', kind: 'due' }, { date: r.due, day: r.r.due, text: 'تاریخ تقریبی زایمان', kind: 'due' }, { date: r.hi, day: r.r.hi, text: 'انتهای بازهٔ طبیعی؛ اگر تا این روز زایمان نکرده، مراجعه به دامپزشک', kind: 'due' }]).sort((a, b) => a.date - b.date);
      tb.innerHTML = '';
      rows.forEach((m) => { const tr = document.createElement('tr'); if (m.date < t) tr.className = 'past'; if (m.kind === 'due' && m.day === r.r.due) tr.className = 'next'; tr.innerHTML = `<td>${fmtJ(m.date, true)}</td><td>${fa(daysBetween(d, m.date))}</td><td>${m.kind === 'vet' ? '<span class="k">دامپزشک</span> ' : m.kind === 'care' ? '<span class="k w">مراقبت</span> ' : m.kind === 'due' ? '<span class="k o">زایمان</span> ' : ''}${fa(m.text)}</td>`; tb.appendChild(tr); });
    }
    $('psp').addEventListener('change', () => { fillRef(); run(); }); $('pref').addEventListener('change', run); pick.onChange(run);
    $('pprint').addEventListener('click', () => window.print());
    fillRef(); run();
  </script>
</Tool>
